<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading a beacon sticker in the live viewfinder. Frames are analysed
         and discarded; nothing is recorded or uploaded. -->
    <!-- The people in your phone: read once per press of sync, never in
         the background. Names and one number each go up under a grant the
         person can withdraw; withdrawing drops the book server-side. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Enrolling the owner's own voice. The recording is written to this
         app's private cache and never uploaded; only how long it ran and how
         many turns it held are sent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The conversation you took with you, out of the app entirely. A
         foreground service is the only way a phone lets an app keep a
         microphone open once it is not on screen, and the notification it is
         obliged to show is not a tax to be minimised — it is the difference
         between that feature and an app recording somebody after they left
         it. POST_NOTIFICATIONS because from Android 13 the notification is
         itself a permission, and a service whose indicator can be withheld
         is the thing this is careful about. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="QRME"
        android:supportsRtl="true"
        android:theme="@style/Theme.QrmeStudio"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="QRME"
            android:theme="@style/Theme.QrmeStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Not exported: nothing outside this app may start a microphone
             belonging to it. `microphone` is the declared type, which from
             Android 14 the system checks against the permission above and
             refuses the start without. -->
        <service
            android:name=".WalkService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
