<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.ReachPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <Pivot MaxWidth="680" Margin="20,12" Foreground="{StaticResource QrmeTxtBrush}">

        <!-- Summon: @handle + placed QR beacons -->
        <PivotItem x:Name="SummonPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="HandleHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="HandleSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <TextBox x:Name="HandleBox" />
                            <Button x:Name="ClaimButton" Click="OnClaim"
                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                            <TextBlock x:Name="ClaimedText" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource QrmeGreenBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="BeaconsHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="BeaconsSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <TextBox x:Name="BeaconLabelBox" />
                            <TextBox x:Name="BeaconLocationBox" />
                            <Button x:Name="PlaceBeaconButton" Click="OnPlaceBeacon"
                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                            <TextBlock x:Name="QrText" FontSize="10" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="BeaconList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <Button Grid.Column="1" Content="{Binding PickUpLabel}" Tag="{Binding Id}"
                                                    Click="OnPickUp" Visibility="{Binding ActiveVisibility}"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource QrmeRedBrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="TrySummonHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBox x:Name="RefBox" />
                            <Button x:Name="SummonButton" Click="OnSummon"
                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                            <ItemsControl x:Name="SummonList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11"
                                                       Foreground="{StaticResource QrmeT2Brush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="BeaconMeta" FontSize="11" Visibility="Collapsed"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                        </StackPanel>
                    </Border>
                    <!-- The open door's other side: an audience that asked,
                         rather than one the profile reached for. The
                         console's Audience card, carried here as the
                         backlog promised. -->
                    <Border x:Name="OpenersCard" Visibility="Collapsed"
                            Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="OpenersHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="OpenersPitch" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <ItemsControl x:Name="OpenersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Line}" FontSize="12"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SummonError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Marketplace -->
        <PivotItem x:Name="MarketPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="ListHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="ListSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <TextBox x:Name="TitleBox" />
                            <TextBox x:Name="BlurbBox" />
                            <TextBox x:Name="TagsBox" />
                            <Button x:Name="CreateListingButton" Click="OnCreateListing"
                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MarketError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="MarketStatus" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="WellbeingHead" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <ItemsControl x:Name="QuickTags">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="WellbeingNote"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="FilterTagBox" Width="240" />
                        <Button x:Name="BrowseButton" Click="OnBrowse"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    </StackPanel>
                    <ItemsControl x:Name="ListingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12"
                                                       Foreground="{StaticResource QrmeBrandABrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Blurb}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TagLine}" FontSize="11"
                                                       Foreground="{StaticResource QrmeT2Brush}" />
                                            <Button Grid.Column="1" Content="{Binding RemoveLabel}" Tag="{Binding Id}"
                                                    Click="OnRemoveListing" Visibility="{Binding MineVisibility}"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource QrmeRedBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Knowledge packs -->
        <PivotItem x:Name="PacksPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="PacksHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="PacksSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="PackIndustryBox" Width="240" />
                                <Button x:Name="BrowsePacksButton" Click="OnBrowsePacks"
                                        Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PackSourcesHead" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="PackSourcesSub"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT3Brush}" />
                            <ItemsControl x:Name="RegistryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource QrmeBrandABrush}" />
                                                <TextBlock Text="{Binding Tagline}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{StaticResource QrmeT2Brush}" />
                                                <TextBlock Text="{Binding SyncState}" FontSize="10"
                                                           Foreground="{StaticResource QrmeT3Brush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding Key}"
                                                    Click="OnSyncRegistry" FontSize="12"
                                                    IsEnabled="{Binding CanSync}" VerticalAlignment="Center"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PackError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="PackStatus" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="PackList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding PriceLabel}" FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeAmberBrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Blurb}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11"
                                                   Foreground="{StaticResource QrmeT3Brush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding InstalledLabel}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeGreenBrush}"
                                                       Visibility="{Binding InstalledVisibility}" />
                                            <Button Content="{Binding RemoveLabel}" Tag="{Binding Id}" Click="OnUninstallPack"
                                                    Visibility="{Binding InstalledVisibility}"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource QrmeRedBrush}" />
                                            <Button Content="{Binding ActionLabel}" Tag="{Binding Id}"
                                                    Click="OnInstallPack"
                                                    Visibility="{Binding AvailableVisibility}"
                                                    Background="{StaticResource QrmeBrandABrush}"
                                                    Foreground="White" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Licensing -->
        <PivotItem x:Name="LicensePivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="LicenseHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="LicenseSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="PriceBox" PlaceholderText="0" />
                            <TextBox x:Name="TermsBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SetOfferButton" Click="OnSetLicense"
                                        Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                                <Button x:Name="UnlistButton" Click="OnUnlist"
                                        Visibility="Collapsed" Background="Transparent" FontSize="12"
                                        Foreground="{StaticResource QrmeRedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="OfferText" FontSize="12" Visibility="Collapsed"
                                       Foreground="{StaticResource QrmeGreenBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LicenseError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="GrantList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding RevokedLabel}" FontSize="12"
                                                           Visibility="{Binding RevokedVisibility}"
                                                           Foreground="{StaticResource QrmeRedBrush}" />
                                                <Button Content="{Binding RevokeLabel}" Tag="{Binding Id}" Click="OnRevokeGrant"
                                                        Visibility="{Binding ActiveVisibility}"
                                                        Background="Transparent" FontSize="12"
                                                        Foreground="{StaticResource QrmeRedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Derived}" FontSize="11"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                        <TextBlock Text="{Binding Manifest}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem x:Name="EarnPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="EarningsHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="EarningsSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <StackPanel>
                                    <TextBlock x:Name="AccruedText" Text="—" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource QrmeGreenBrush}" />
                                    <TextBlock x:Name="AccruedLabel" FontSize="11" Foreground="{StaticResource QrmeT2Brush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="PaidText" Text="—" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                    <TextBlock x:Name="PaidLabel" FontSize="11" Foreground="{StaticResource QrmeT2Brush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="LifetimeText" Text="—" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource QrmeBrandABrush}" />
                                    <TextBlock x:Name="LifetimeLabel" FontSize="11" Foreground="{StaticResource QrmeT2Brush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="ByKindText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT3Brush}" Visibility="Collapsed" />
                            <Button x:Name="PayoutButton" Click="OnRequestPayout"
                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                            <TextBlock x:Name="PayoutText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeGreenBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LedgerHead" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <ItemsControl x:Name="LedgerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Kind}" FontWeight="Bold" FontSize="12"
                                                   Foreground="{StaticResource QrmeTxtBrush}" />
                                        <TextBlock Text="{Binding Memo}" FontSize="10"
                                                   Foreground="{StaticResource QrmeT3Brush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Amount}" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource QrmeGreenBrush}" />
                                        <TextBlock Text="{Binding Status}" FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource QrmeT3Brush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EarningsError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
