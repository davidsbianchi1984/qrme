<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.SignaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Margin="20,12" Spacing="12" Padding="4">

            <!-- Stated up front rather than discovered by a failing button. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Signing happens on your phone" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}"
                               Text="This desktop app reads and verifies signatures; it does not create them. Reaching Windows Hello as a WebAuthn authenticator needs webauthn.dll interop that is not written yet, and shipping that untested would produce a button that looks like it signs and does not. Enrol and sign in the iOS or Android app; everything below reads the same records." />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Your signing credentials" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <ItemsControl x:Name="CredentialList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource QrmeTxtBrush}" />
                                    <TextBlock Text="{Binding Proofing}" FontSize="11"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                    <TextBlock Text="{Binding Custody}" FontSize="11"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                    <TextBlock Text="{Binding Tiers}" FontSize="10"
                                               Foreground="{StaticResource QrmeT3Brush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CredentialsEmpty" FontSize="12" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}"
                               Text="No signing credentials enrolled for this account yet." />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Look up a signature" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="SignatureIdBox" Header="Signature id" PlaceholderText="sig_…" />
                    <Button Content="Fetch and re-verify" Click="OnFetch"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="VerdictText" FontSize="14" FontWeight="Bold"
                               Visibility="Collapsed" TextWrapping="Wrap" />
                    <TextBlock x:Name="MeaningText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ShownText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="DetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Verify a package from elsewhere" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}"
                               Text="Paste an evidence package a counterparty handed you. It is checked against its own contents — no account, no lookup, no trust in this deployment beyond the arithmetic." />
                    <TextBox x:Name="PackageBox" Header="Evidence package (JSON)"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="120" />
                    <Button Content="Verify" Click="OnVerifyPackage"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="PackageVerdict" FontSize="13" FontWeight="Bold"
                               Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StandardText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource QrmeT3Brush}" />
            <TextBlock x:Name="ErrorText" FontSize="12" Visibility="Collapsed"
                       TextWrapping="Wrap" Foreground="{StaticResource QrmeRedBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
