<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <Pivot MaxWidth="680" Margin="20,12" Foreground="{StaticResource QrmeTxtBrush}">

        <!-- Social platform connections -->
        <PivotItem x:Name="SocialPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SocialHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="SocialSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <ComboBox x:Name="PlatformBox" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="HandleBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CollectButton" Click="OnConnectCollect"
                                        Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                                <Button x:Name="PublishButton" Click="OnConnectPublish"
                                        Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SocialError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="SocialStatus" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="SocialList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Handle}" FontSize="12"
                                                       Foreground="{StaticResource QrmeT2Brush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Tally}" FontSize="12"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Visibility="{Binding ActiveVisibility}">
                                            <Button Content="{Binding CollectLabel}" Tag="{Binding Id}" Click="OnCollect"
                                                    Visibility="{Binding CollectVisibility}"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding ScrapeLabel}" Tag="{Binding Id}" Click="OnScrape"
                                                    Visibility="{Binding ScrapeVisibility}"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding PublishLabel}" Tag="{Binding Id}" Click="OnPublish"
                                                    Visibility="{Binding PublishVisibility}"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding DisconnectLabel}" Tag="{Binding Id}" Click="OnRevoke"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource QrmeRedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Connected-apps catalog -->
        <PivotItem x:Name="AppsPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="AppsHead" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource QrmeTxtBrush}" />
                            <TextBlock x:Name="AppsSub"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource QrmeT2Brush}" />
                            <!-- The whole board, searchable. It used to be
                                 Take(12) against a catalogue of a hundred and
                                 three — a shop showing a twelfth of its
                                 shelves with no way to ask for the rest. -->
                            <TextBox x:Name="AppFind" TextChanged="OnAppFind" />
                            <ItemsControl x:Name="CatalogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{StaticResource QrmeTxtBrush}" />
                                                <TextBlock Text="{Binding Provider}" FontSize="11"
                                                           Foreground="{StaticResource QrmeT2Brush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Lock}" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource QrmeT2Brush}" />
                                                <Button Content="{Binding ConnectLabel}" Tag="{Binding Key}"
                                                        Click="OnAppConnect"
                                                        Background="Transparent" FontSize="12"
                                                        Foreground="{StaticResource QrmeBrandABrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AppsError" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="AppsStatus" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="AppConnList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                       Foreground="{StaticResource QrmeTxtBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Provider}" FontSize="12"
                                                       Foreground="{StaticResource QrmeT2Brush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Posture}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ActiveVisibility}"
                                                   Foreground="{StaticResource QrmeT2Brush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Visibility="{Binding ActiveVisibility}">
                                            <Button Content="{Binding AppCollectLabel}" Tag="{Binding Id}" Click="OnAppCollect"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                                            <Button Content="{Binding InvokeLabel}" Tag="{Binding Id}" Click="OnAppInvoke"
                                                    Visibility="{Binding InvokeVisibility}"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                                            <!-- The credential the lock is about. It goes to the
                                                 vault; this shell keeps nothing. -->
                                            <TextBox x:Name="AppSecret" Tag="{Binding Id}" MinWidth="140"
                                                     PlaceholderText="{Binding SecretLabel}"
                                                     Visibility="{Binding SignInVisibility}" />
                                            <Button Content="{Binding SignInLabel}" Tag="{Binding Id}" Click="OnAppAuthorize"
                                                    Visibility="{Binding SignInVisibility}"
                                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                                            <!-- Uninstall. Until this round no shell had it. -->
                                            <Button Content="{Binding RemoveLabel}" Tag="{Binding Id}" Click="OnAppRevoke"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource QrmeRedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
