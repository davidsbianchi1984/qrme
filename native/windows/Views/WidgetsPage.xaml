<Page
    x:Class="QrmeStudio.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="12">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="Sub" Opacity="0.7" TextWrapping="Wrap"/>
            <TextBlock x:Name="NoBox" Opacity="0.7" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="ErrorText" Foreground="#ff8fa0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="YoursLabel" FontWeight="Bold"/>
            <ListView x:Name="WidgetList" SelectionChanged="OnPick"
                      MaxHeight="180"/>
            <Button x:Name="RemoveButton" Click="OnRemove"/>

            <TextBox x:Name="NameBox"/>
            <TextBox x:Name="SourceBox" AcceptsReturn="True" Height="220"
                     FontFamily="Consolas" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Click="OnSave"/>
                <Button x:Name="RunButton" Click="OnRun"/>
            </StackPanel>
            <TextBlock x:Name="Walls" Opacity="0.7" TextWrapping="Wrap"/>

            <TextBlock x:Name="AnswerStatus" FontWeight="Bold"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="AnswerSaid" Opacity="0.7" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="AnswerBody" FontFamily="Consolas"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
