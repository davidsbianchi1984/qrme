<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Margin="20,12" Spacing="12" Padding="4">

            <!-- Step 802 — the permission, before anything is collected. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="Step1" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ConsentText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <Button x:Name="GrantButton"
                            Click="OnGrant"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <Button x:Name="WithdrawButton" Visibility="Collapsed" Click="OnRevoke"
                            Background="{StaticResource QrmeRedBrush}" Foreground="White" />
                    <TextBlock x:Name="RevokedText" FontSize="11" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource QrmeAmberBrush}" />
                </StackPanel>
            </Border>

            <!-- Steps 806–810 — samples, and what they amount to. -->
            <Border x:Name="EnrollmentCard" Visibility="Collapsed"
                    Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="Step2" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}"
                               x:Name="TapNote" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RecordButton" Click="OnRecord"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                        <TextBlock x:Name="ElapsedText" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{StaticResource QrmeGreenBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CountsText" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ThresholdText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <TextBlock x:Name="NeedsText" FontSize="11" TextWrapping="Wrap"
                               Visibility="Collapsed" Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="MethodText" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <TextBlock FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}"
                               x:Name="StaysNote" />
                </StackPanel>
            </Border>

            <!-- Step 812 — the print, and speaking with it. -->
            <Border x:Name="VoiceprintCard" Visibility="Collapsed"
                    Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="Step3" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="PrintText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <Button x:Name="BuildButton" Click="OnBuild"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <StackPanel x:Name="SpeakPanel" Visibility="Collapsed" Spacing="8">
                        <TextBox x:Name="SayBox"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                        <Button x:Name="SpeakButton" Click="OnSpeak"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                        <TextBlock x:Name="BasisText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource QrmeT2Brush}" />
                        <TextBlock x:Name="SpokenDisclosure" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource QrmeAmberBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The spoken voice: a reference to a voice made on the
                 engine's own surface, and one utterance of audio back. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SpokenHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="SpokenLead" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <StackPanel x:Name="BindPanel" Spacing="8">
                        <TextBox x:Name="BindIdBox" />
                        <TextBox x:Name="BindLabelBox" />
                        <Button x:Name="BindButton" Click="OnBind"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    </StackPanel>
                    <StackPanel x:Name="BoundPanel" Visibility="Collapsed" Spacing="8">
                        <TextBlock x:Name="BoundText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource QrmeTxtBrush}" />
                        <TextBox x:Name="SayLineBox" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SayButton" Click="OnSay"
                                    Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                            <Button x:Name="UnbindButton" Click="OnUnbind" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="HoldsHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}"
                               x:Name="HoldsMark" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}"
                               x:Name="HoldsOwn" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}"
                               x:Name="HoldsWithdraw" />
                    <TextBlock x:Name="DisclosureText" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" FontSize="12" Visibility="Collapsed"
                       TextWrapping="Wrap" Foreground="{StaticResource QrmeRedBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
