<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="440" Spacing="20" Padding="24,40" HorizontalAlignment="Center">
            <Ellipse Width="84" Height="84" HorizontalAlignment="Center">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="SubText"
                       FontSize="13" Foreground="{StaticResource QrmeT2Brush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="12">
                    <TextBox x:Name="NameBox" />
                    <TextBox x:Name="PersonaBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                    <!-- The items carried the API's enum members as their visible text, and
                         OnStart read that text back as the value to post. Translating
                         the label would have posted the Spanish word as the kind, so
                         the members move into `_kinds` in code-behind and only the word
                         somebody reads is looked up. -->
                    <ComboBox x:Name="KindBox" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="BirthBox" Text="1984-01-01" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TermsText"
                       Foreground="{StaticResource QrmeT3Brush}" FontSize="10" TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Button x:Name="StartButton" HorizontalAlignment="Stretch"
                    Height="46" Foreground="White" Click="OnStart">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
            <!-- Or carry in a character card; the response names what it
                 refused to carry. -->
            <TextBlock x:Name="CardHead" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBox x:Name="CardBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            <Button x:Name="ImportCardButton" HorizontalAlignment="Stretch"
                    Click="OnImportCard" Background="Transparent"
                    Foreground="{StaticResource QrmeBrandABrush}" FontSize="12" />

                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- The other reason somebody opens this app: they have found a
                 synthetic profile of themselves, or were sent something and
                 want to know whether a person wrote it. Both routes are
                 public on the backend and both sat behind this gate. -->
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="InviteText"
                           Foreground="{StaticResource QrmeT2Brush}" FontSize="12"
                           HorizontalAlignment="Center" />
                <Button x:Name="DoorButton"
                        HorizontalAlignment="Center" Background="Transparent"
                        Foreground="{StaticResource QrmeBrandABrush}" Click="OnPublicDoor" />
                <TextBlock x:Name="NoAccountText"
                           Foreground="{StaticResource QrmeT3Brush}" FontSize="11"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="BackendHint"
                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource QrmeT2Brush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
