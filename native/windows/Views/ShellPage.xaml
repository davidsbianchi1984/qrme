<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Left" SelectionChanged="OnSelectionChanged"
                    Background="{StaticResource QrmeScrBotBrush}">
        <NavigationView.MenuItems>
            <NavigationViewItem Tag="overview" IsSelected="True">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="chat">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="community">
                <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="compose">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="posts">
                <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="study">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="widgets">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="connect">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="gaming">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Emoji" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="robots">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="reach">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="desk">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="shops">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Shop" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="corner">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="people">
                <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="counter">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Shop" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="signatures">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="voice">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Microphone" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="SignOutButton" Margin="12" Click="OnSignOut"
                    Foreground="{StaticResource QrmeT2Brush}" Background="Transparent" />
        </NavigationView.PaneFooter>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
