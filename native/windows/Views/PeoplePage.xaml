                    </StackPanel>
                    <TextBox x:Name="ExitRefBox" />
                    <Button x:Name="ExitSucceedButton" Click="OnExitSucceed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExitSunsetButton" Click="OnExitSunset" />
                        <Button x:Name="ExitDeleteButton" Click="OnExitDelete" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The face it shows the world: portrait, emblem, page,
                 surfaces, blend, bodies, dials and the wrist. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AvaTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AvaShowButton" Click="OnAvaShow" />
                        <Button x:Name="AvaBriefsButton" Click="OnAvaBriefs" />
                    </StackPanel>
                    <TextBox x:Name="AvaAssetBox" />
                    <Button x:Name="AvaSetButton" Click="OnAvaSet" />
                    <TextBox x:Name="AvaHandleBox" />
                    <Button x:Name="AvaBriefButton" Click="OnAvaBrief" />
                    <TextBlock x:Name="AvaMarketTitle" FontWeight="Bold" FontSize="13" />
                    <!-- Which system the face is coming from. This page used
                         to fetch the eight-row shelf, show its length, and
                         then import everything as "other" — the provenance
                         the route exists to keep, discarded at the last
                         step. -->
                    <ComboBox x:Name="AvaSourceBox"
                              SelectionChanged="OnAvaSourceChanged"
                              HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="AvaSourceHow" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBox x:Name="AvaImportBox" />
                    <Button x:Name="AvaImportButton" Click="OnAvaImport" />
                </StackPanel>
            </Border>

            <!-- The emblem and the badge. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="EmblTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EmblListButton" Click="OnEmblList" />
                        <Button x:Name="EmblRulesButton" Click="OnEmblRules" />
                        <Button x:Name="EmblBadgeButton" Click="OnEmblBadge" />
                    </StackPanel>
                    <TextBox x:Name="EmblPickBox" />
                    <Button x:Name="EmblSetButton" Click="OnEmblSet" />
                </StackPanel>
            </Border>

            <!-- The page and the first screen. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PgTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PgShowButton" Click="OnPgShow" />
                        <Button x:Name="PgThemesButton" Click="OnPgThemes" />
                        <Button x:Name="FrontShowButton" Click="OnFrontShow" />
                    </StackPanel>
                    <TextBox x:Name="PgThemeBox" />
                    <TextBox x:Name="PgTaglineBox" />
                    <TextBox x:Name="PgAboutBox" />
                    <Button x:Name="PgSaveButton" Click="OnPgSave" />
                </StackPanel>
            </Border>

            <!-- Surfaces and the blend. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SurfTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SurfListButton" Click="OnSurfList" />
                        <Button x:Name="CompShowButton" Click="OnCompShow" />
                    </StackPanel>
                    <TextBox x:Name="SurfSetBox" />
                    <Button x:Name="SurfSetButton" Click="OnSurfSet" />
                </StackPanel>
            </Border>

            <!-- The bodies it lives in. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FormTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <ItemsControl x:Name="FormList" />
                    <TextBox x:Name="FormNameBox" />
                    <TextBox x:Name="FormKindBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FormAddButton" Click="OnFormAdd" />
                        <Button x:Name="FormSameButton" Click="OnFormSame" />
                    </StackPanel>
                    <TextBox x:Name="FormScreenBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FormScreensButton" Click="OnFormScreens" />
                        <Button x:Name="FormScreenAddButton" Click="OnFormScreenAdd" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The dials. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SteerTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="SteerShowButton" Click="OnSteerShow" />
                    <TextBox x:Name="SteerPaceBox" />
                    <TextBox x:Name="SteerAutonomyBox" />
                    <Button x:Name="SteerSetButton" Click="OnSteerSet" />
                </StackPanel>
            </Border>

            <!-- The wrist. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WristTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="WristShowButton" Click="OnWristShow" />
                    <TextBox x:Name="WristTargetBox" />
                    <TextBox x:Name="WristIdBox" />
                    <TextBox x:Name="WristActionBox" />
                    <TextBox x:Name="WristInputBox" />
                    <Button x:Name="WristActButton" Click="OnWristAct" />
                </StackPanel>
            </Border>

            <!-- The keys: the account itself. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AcctTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="AcctEmailBox" />
                    <PasswordBox x:Name="AcctPasswordBox" />
                    <TextBox x:Name="AcctNameBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcctSignupButton" Click="OnAcctSignup" />
                        <Button x:Name="AcctSigninButton" Click="OnAcctSignin" />
                    </StackPanel>
                    <!-- What this account already holds, filled by signing in.
                         The list carries no credential; Open is what mints an
                         owner token for the one chosen. -->
                    <TextBlock x:Name="AcctHeldTitle" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="AcctHeldPitch" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <ComboBox x:Name="AcctHeldBox" />
                    <Button x:Name="AcctHeldOpenButton" Click="OnAcctOpenHeld" />
                    <TextBox x:Name="AcctCodeBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcctVerifyButton" Click="OnAcctVerify" />
                        <Button x:Name="AcctResendButton" Click="OnAcctResend" />
                    </StackPanel>
                    <PasswordBox x:Name="AcctNewPasswordBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcctResetRequestButton" Click="OnAcctResetRequest" />
                        <Button x:Name="AcctResetButton" Click="OnAcctReset" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcctOauthButton" Click="OnAcctOauth" />
                        <Button x:Name="AcctOauthClaimButton" Click="OnAcctOauthClaim" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The till. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TillTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TillPlansButton" Click="OnTillPlans" />
                        <Button x:Name="TillSubsButton" Click="OnTillSubs" />
                        <Button x:Name="TillOrdersButton" Click="OnTillOrders" />
                    </StackPanel>
                    <TextBox x:Name="TillSubIdBox" />
                    <TextBox x:Name="TillBeneficiaryBox" />
                    <Button x:Name="TillRenewButton" Click="OnTillRenew" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TillProceedsButton" Click="OnTillProceeds" />
                        <Button x:Name="TillCampaignsButton" Click="OnTillCampaigns" />
                    </StackPanel>
                    <TextBox x:Name="TillDesigneeBox" />
                    <Button x:Name="TillSetButton" Click="OnTillSet" />
                    <TextBox x:Name="TillCampTitleBox" />
                    <TextBox x:Name="TillCampGoalBox" />
                    <Button x:Name="TillCampAddButton" Click="OnTillCampAdd" />
                </StackPanel>
            </Border>

            <!-- The lifeline. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LifeTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LifeCloudButton" Click="OnLifeCloud" />
                        <Button x:Name="LifeOfflineButton" Click="OnLifeOffline" />
                        <Button x:Name="LifeLightsButton" Click="OnLifeLights" />
                        <Button x:Name="LifeTopicsButton" Click="OnLifeTopics" />
                    </StackPanel>
                    <TextBox x:Name="LifeQuestionBox" />
                    <Button x:Name="LifeAskButton" Click="OnLifeAsk" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LifeProvidersButton" Click="OnLifeProviders" />
                    </StackPanel>
                    <TextBox x:Name="LifeProvNameBox" />
                    <TextBox x:Name="LifeProvAreaBox" />
                    <Button x:Name="LifeProvAddButton" Click="OnLifeProvAdd" />
                </StackPanel>
            </Border>

            <!-- The sticker on the street. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BcnTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="BcnIdBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BcnCardButton" Click="OnBcnCard" />
                        <Button x:Name="BcnDeskButton" Click="OnBcnDesk" />
                        <Button x:Name="BcnQrButton" Click="OnBcnQr" />
                    </StackPanel>
                    <TextBox x:Name="BcnCidBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BcnSocialButton" Click="OnBcnSocial" />
                        <Button x:Name="BcnPairButton" Click="OnBcnPair" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The queue. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ModqTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="ModqShowButton" Click="OnModqShow" />
                    <TextBox x:Name="ModqMsgBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ModqApproveButton" Click="OnModqApprove" />
                        <Button x:Name="ModqRejectButton" Click="OnModqReject" />
                    </StackPanel>
                    <TextBox x:Name="ModqInteractorBox" />
                    <TextBox x:Name="ModqContentBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ModqEditButton" Click="OnModqEdit" />
                        <Button x:Name="ModqRetractButton" Click="OnModqRetract" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The reviews. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="RevwTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="RevwShowButton" Click="OnRevwShow" />
                    <TextBox x:Name="RevwInteractorBox" />
                    <TextBox x:Name="RevwRatingBox" />
                    <TextBox x:Name="RevwBodyBox" />
                    <Button x:Name="RevwLeaveButton" Click="OnRevwLeave" />
                </StackPanel>
            </Border>

            <!-- The stamp. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WmTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="WmIdBox" />
                    <Button x:Name="WmResolveButton" Click="OnWmResolve" />
                    <TextBox x:Name="WmContentBox" />
                    <Button x:Name="WmVerifyButton" Click="OnWmVerify" />
                </StackPanel>
            </Border>

            <!-- The media. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MedTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MedLimitsButton" Click="OnMedLimits" />
                        <Button x:Name="MedPlatformsButton" Click="OnMedPlatforms" />
                    </StackPanel>
                    <TextBox x:Name="MedFilenameBox" />
                    <Button x:Name="MedUploadButton" Click="OnMedUpload" />
                    <Button x:Name="MedGalleryButton" Click="OnMedGallery" />
                    <TextBlock x:Name="MedGalleryText" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>

            <!-- The wearables. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WearTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="WearListButton" Click="OnWearList" />
                    <TextBox x:Name="WearNameBox" />
                    <TextBox x:Name="WearKindBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="WearPairButton" Click="OnWearPair" />
                        <Button x:Name="WearUnpairButton" Click="OnWearUnpair" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The birth. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BornTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="BornOwnerBox" />
                    <TextBox x:Name="BornNameBox" />
                    <TextBox x:Name="BornSocialBox" />
                    <TextBox x:Name="BornHumorBox" />
                    <TextBox x:Name="BornMattersBox" />
                    <TextBox x:Name="BornComfortBox" />
                    <Button x:Name="BornMakeButton" Click="OnBornMake" />
                    <TextBox x:Name="BornSourcesBox" />
                    <Button x:Name="BornBlendButton" Click="OnBornBlend" />
                    <TextBox x:Name="BornPackIndustryBox" />
                    <TextBox x:Name="BornPackTitleBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BornPackPublishButton" Click="OnBornPackPublish" />
                        <Button x:Name="BornPackSeedButton" Click="OnBornPackSeed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The mind at work. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MindTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="MindScenarioBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MindSimulateButton" Click="OnMindSimulate" />
                        <Button x:Name="MindRunsButton" Click="OnMindRuns" />
                        <Button x:Name="MindTuneButton" Click="OnMindTune" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MindCloudButton" Click="OnMindCloud" />
                        <Button x:Name="MindRevokeButton" Click="OnMindRevoke" />
                    </StackPanel>
                    <TextBox x:Name="MindCidBox" />
                    <Button x:Name="MindExcursionButton" Click="OnMindExcursion" />
                </StackPanel>
            </Border>

            <!-- The reach. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ReachTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReachCheckinButton" Click="OnReachCheckin" />
                        <Button x:Name="ReachRateUpButton" Click="OnReachRateUp" />
                        <Button x:Name="ReachRateDownButton" Click="OnReachRateDown" />
                    </StackPanel>
                    <TextBox x:Name="ReachQuietStartBox" />
                    <TextBox x:Name="ReachQuietEndBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReachQuietSetButton" Click="OnReachQuietSet" />
                        <Button x:Name="ReachReferralsButton" Click="OnReachReferrals" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The license. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LicTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="LicAcquireButton" Click="OnLicAcquire" />
                    <TextBox x:Name="LicGrantBox" />
                    <Button x:Name="LicDeriveButton" Click="OnLicDerive" />
                </StackPanel>
            </Border>

            <!-- The senses. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SensTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="SensSceneBox" />
                    <TextBox x:Name="SensGoalBox" />
                    <Button x:Name="SensPerceiveButton" Click="OnSensPerceive" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SensMicsButton" Click="OnSensMics" />
                        <Button x:Name="SensVocabButton" Click="OnSensVocab" />
                        <Button x:Name="SensOverlaysButton" Click="OnSensOverlays" />
                        <Button x:Name="SensHealthButton" Click="OnSensHealth" />
                    </StackPanel>
                    <TextBox x:Name="SensExpBox" />
                    <Button x:Name="SensExpSetButton" Click="OnSensExpSet" />
                    <TextBox x:Name="SensCredBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SensCredRemoveButton" Click="OnSensCredRemove" />
                        <Button x:Name="SensDeskJoinButton" Click="OnSensDeskJoin" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
