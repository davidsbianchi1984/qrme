<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.PeoplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <!-- The people around a profile: the friends list, who the platform
         suggests and why, the wall, and the comments under a post. Every
         visible string is set in code-behind from L10n. -->
    <ScrollViewer>
        <StackPanel MaxWidth="740" Spacing="16" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />

            <!-- What happened while you were away: the deed, never the
                 words. Hidden entirely while the inbox is empty. -->
            <Border x:Name="InboxCard" Visibility="Collapsed"
                    Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InboxTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <ItemsControl x:Name="InboxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="InboxSeenButton" Click="OnInboxSeen" />
                </StackPanel>
            </Border>

            <!-- Somebody else's homepage, in place. The console got this
                 screen in the homepage round; this shell got the routes and
                 nowhere to land, so a friend here was a line of text and
                 nothing you could open.

                 No stats row, and that is not an omission:
                 `GET /profiles/{id}/stats` is require_owner, which is
                 exactly why the console's old inline card — having no way to
                 fetch theirs — showed *your* numbers under their name.

                 The markup block is named rather than drawn. Rendering it
                 would mean pointing a WebView2 at a stranger's stored HTML,
                 and this app's only WebView2 runs the first-party signature
                 ceremony. See VisitMarkupText. -->
            <Border x:Name="VisitCard" Visibility="Collapsed"
                    Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VisitName" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="VisitTheirs" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="VisitAbout" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="VisitMarkupText" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="VisitPlain" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="VisitLinks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeBrandABrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="VisitSayLabel" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBox x:Name="VisitSayBox" AcceptsReturn="True" Height="60" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="VisitTalkButton" Click="OnVisitTalk" />
                        <Button x:Name="VisitMessageButton" Click="OnVisitMessage"
                                Visibility="Collapsed" />
                        <Button x:Name="VisitBefriendButton" Click="OnVisitBefriend"
                                Visibility="Collapsed" />
                        <Button x:Name="VisitRoomButton" Click="OnVisitRoom" />
                        <Button x:Name="VisitCloseButton" Click="OnVisitClose" />
                    </StackPanel>
                    <TextBlock x:Name="VisitStateNote" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="VisitReply" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <!-- The briefcase. Handing somebody a document is part of
                         talking to them, so it sits inside this panel rather
                         than behind a page of its own. What is handed over is
                         read once at import and carried as a digest — the
                         counts on each row are that claim made checkable. -->
                    <TextBlock x:Name="BcHeading" FontSize="13" FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="BcWhy" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BcFileButton" Click="OnBriefcaseFile" />
                        <TextBox x:Name="BcLinkBox" Width="220" />
                        <TextBox x:Name="BcNoteBox" Width="180" />
                        <Button x:Name="BcImportButton" Click="OnBriefcaseLink" />
                    </StackPanel>
                    <TextBlock x:Name="BcOffline" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <ListView x:Name="BcList" SelectionMode="Single"
                              SelectionChanged="OnBriefcaseSelected"
                              MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BcShowButton" Click="OnBriefcaseShow" />
                        <Button x:Name="BcRemoveButton" Click="OnBriefcaseRemove" />
                    </StackPanel>
                    <TextBlock x:Name="BcTaken" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="VisitTopLabel" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="VisitTopList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="VisitCounts" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="VisitWall">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="VisitMedia">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="VisitOffersLabel" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="VisitOffers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <!-- Everyone here: the browse pool and its honest head
                         count — every profile on the deployment, real and
                         synthetic side by side, listed until its owner
                         goes private. The button is this profile's own
                         door out and back in. -->
                    <TextBlock x:Name="PoolHead" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="PoolCount" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="PoolStanding" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <Button x:Name="PoolSwitchButton" Click="OnFlipListing" />
                    <ItemsControl x:Name="PoolList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Find people: publicly listed profiles by name or
                         handle — the door two beta testers needed to
                         become friends. -->
                    <TextBlock x:Name="FindHead" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="FindQBox" />
                    <Button x:Name="FindButton" Click="OnFindPeople" />
                    <TextBlock x:Name="FindNoneText" FontSize="11" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="FoundList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The id typed here is the door. A friend row above is
                         a line of text on this shell; this is what opens
                         one, and it takes any profile id, which is what a
                         visitor arriving from a QR sticker actually has. -->
                    <TextBox x:Name="VisitIdBox" />
                    <Button x:Name="VisitButton" Click="OnVisit" />
                    <ItemsControl x:Name="FriendList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="FriendIdBox" />
                    <Button x:Name="AddFriendButton" Click="OnAddFriend" />
                    <Button x:Name="RemoveFriendButton" Click="OnRemoveFriend" />
                    <TextBlock x:Name="PinnedNote" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SuggestedTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="RankedText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="SuggestedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WallTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="PostBox" />
                    <Button x:Name="PostButton" Click="OnPost" />
                    <ItemsControl x:Name="PostList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CommentsTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="PostIdBox" />
                    <Button x:Name="OpenCommentsButton" Click="OnOpenComments" />
                    <ItemsControl x:Name="CommentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="CommentBox" />
                    <Button x:Name="CommentButton" Click="OnComment" />
                    <TextBox x:Name="CommentIdBox" />
                    <Button x:Name="WithdrawButton" Click="OnWithdraw" />
                    <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>
            <!-- The crowd: like, share, subscribe, gift. The backend reports
                 the numbers and the caller's own state in one call. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CrowdTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="CrowdKindBox" />
                    <TextBox x:Name="CrowdTargetBox" />
                    <Button x:Name="LikeButton" Click="OnLike" />
                    <Button x:Name="UnlikeButton" Click="OnUnlike" />
                    <Button x:Name="ShareButton" Click="OnShare" />
                    <Button x:Name="CountsButton" Click="OnCounts" />
                    <Button x:Name="FollowButton" Click="OnFollow" />
                    <Button x:Name="UnfollowButton" Click="OnUnfollow" />
                    <Button x:Name="SubscribersButton" Click="OnSubscribers" />
                    <TextBlock x:Name="CountsText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="GiftNoteText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBox x:Name="GiftAmountBox" />
                    <TextBox x:Name="GiftWordsBox" />
                    <Button x:Name="GiftButton" Click="OnGift" />
                    <Button x:Name="GiftsButton" Click="OnGifts" />
                    <ItemsControl x:Name="GiftList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The couch: a watch party around a posted video. Seek moves a
                 number and presses play on nobody's device. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PartyTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <!-- The browse door. The id box below stays the private
                         one: these rows join without ever showing an id. -->
                    <Button x:Name="PartyPublicButton" Click="OnPartyPublicList" />
                    <ItemsControl x:Name="PartyPublicList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Line}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                    <Button Content="{Binding Action}" Tag="{Binding Id}"
                                            Click="OnPartyPublicJoin" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="PartyPostBox" />
                    <TextBox x:Name="PartyNameBox" />
                    <Button x:Name="PartyStartButton" Click="OnPartyStart" />
                    <TextBox x:Name="PartyIdBox" />
                    <Button x:Name="PartyJoinButton" Click="OnPartyJoin" />
                    <Button x:Name="PartyShowButton" Click="OnPartyShow" />
                    <Button x:Name="PartyLeaveButton" Click="OnPartyLeave" />
                    <Button x:Name="PartyEndButton" Click="OnPartyEnd" />
                    <!-- Host only, both directions; the id keeps working
                         either way. -->
                    <Button x:Name="PartyPublishButton" Click="OnPartyPublish" />
                    <Button x:Name="PartyUnpublishButton" Click="OnPartyUnpublish" />
                    <TextBlock x:Name="PartyStateText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBox x:Name="PartySeekBox" />
                    <Button x:Name="PartySeekButton" Click="OnPartySeek" />
                    <ItemsControl x:Name="PartyChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="PartySayBox" />
                    <Button x:Name="PartySayButton" Click="OnPartySay" />
                    <Button x:Name="PartyContextButton" Click="OnPartyContext" />
                    <TextBlock x:Name="PartyContextText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>

            <!-- The loan: a skill lent into one place, used and never copied.
                 The terms shown are the backend's own sentences. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LendTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="LendRulesButton" Click="OnLendRules" />
                    <ItemsControl x:Name="LendTermsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="LendBorrowerBox" />
                    <TextBox x:Name="LendSurfaceBox" />
                    <TextBox x:Name="LendSurfaceIdBox" />
                    <TextBox x:Name="LendKindBox" />
                    <TextBox x:Name="LendRefBox" />
                    <TextBox x:Name="LendNameBox" />
                    <Button x:Name="LendOfferButton" Click="OnLendOffer" />
                    <Button x:Name="LendMineButton" Click="OnLendMine" />
                    <ItemsControl x:Name="LendMineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="LendIdBox" />
                    <Button x:Name="LendAcceptButton" Click="OnLendAccept" />
                    <Button x:Name="LendDeclineButton" Click="OnLendDecline" />
                    <Button x:Name="LendCloseButton" Click="OnLendClose" />
                    <Button x:Name="LendShowButton" Click="OnLendShow" />
                    <TextBox x:Name="LendWhatBox" />
                    <Button x:Name="LendUseButton" Click="OnLendUse" />
                    <Button x:Name="LendUsesButton" Click="OnLendUses" />
                    <ItemsControl x:Name="LendUsesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- The place you are in: whose it is, the lent microphone,
                 the worn overlay — disclosure-first. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PlaceTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="PlaceSurfaceBox" />
                    <TextBox x:Name="PlaceSurfaceIdBox" />
                    <Button x:Name="WhoseButton" Click="OnWhose" />
                    <Button x:Name="MicLendButton" Click="OnMicLend" />
                    <Button x:Name="MicBackButton" Click="OnMicBack" />
                    <Button x:Name="MicWhoButton" Click="OnMicWho" />
                    <TextBox x:Name="MaskKindBox" />
                    <TextBox x:Name="MaskNameBox" />
                    <Button x:Name="MaskWearButton" Click="OnMaskWear" />
                    <Button x:Name="MaskOffButton" Click="OnMaskOff" />
                    <Button x:Name="MaskWhoButton" Click="OnMaskWho" />
                    <ItemsControl x:Name="PlaceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The camera, refusals first. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CamTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="CamRulesButton" Click="OnCamRules" />
                    <ItemsControl x:Name="CamRulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="CamSubjectBox" />
                    <TextBox x:Name="CamViewerBox" />
                    <TextBox x:Name="CamMinutesBox" />
                    <Button x:Name="CamOpenButton" Click="OnCamOpen" />
                    <Button x:Name="CamMineButton" Click="OnCamMine" />
                    <Button x:Name="CamDisclosureButton" Click="OnCamDisclosure" />
                    <TextBox x:Name="CamSessionBox" />
                    <Button x:Name="CamShowButton" Click="OnCamShow" />
                    <Button x:Name="CamCloseButton" Click="OnCamClose" />
                    <ItemsControl x:Name="CamList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The owner's organization. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="OrgTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="OrgNameBox" />
                    <Button x:Name="OrgCreateButton" Click="OnOrgCreate" />
                    <Button x:Name="OrgListButton" Click="OnOrgList" />
                    <Button x:Name="OrgDemoButton" Click="OnOrgDemo" />
                    <ItemsControl x:Name="OrgList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="OrgIdBox" />
                    <Button x:Name="OrgShowButton" Click="OnOrgShow" />
                    <TextBox x:Name="DeptNameBox" />
                    <TextBox x:Name="DeptRoleBox" />
                    <TextBox x:Name="DeptProfileBox" />
                    <Button x:Name="DeptAddButton" Click="OnDeptAdd" />
                    <Button x:Name="LeaseButton" Click="OnLease" />
                    <TextBox x:Name="GoalBox" />
                    <TextBox x:Name="FromDeptBox" />
                    <Button x:Name="CoordinateButton" Click="OnCoordinate" />
                    <Button x:Name="CoordLogButton" Click="OnCoordLog" />
                    <ItemsControl x:Name="CoordList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The guided tour. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TourTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="TourOutlineButton" Click="OnTourOutline" />
                    <Button x:Name="TourStartButton" Click="OnTourStart" />
                    <Button x:Name="TourProgressButton" Click="OnTourProgress" />
                    <ItemsControl x:Name="TourList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
