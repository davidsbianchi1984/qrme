<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.StudyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="Sub"
                       Foreground="{StaticResource QrmeT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="TopicBox" />
                    <TextBox x:Name="QuestionBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                    <Button x:Name="StudyButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnStudy">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <ItemsControl x:Name="ExcursionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="{Binding Topic}" FontWeight="Bold"
                                               Foreground="{StaticResource QrmeTxtBrush}" />
                                    <TextBlock Text="{Binding Badge}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding Redacted}" Foreground="{StaticResource QrmeT2Brush}"
                                           FontSize="12" Visibility="{Binding RedactedVisibility}" />
                                <TextBlock Text="{Binding Findings}" Foreground="{StaticResource QrmeTxtBrush}"
                                           FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FoldedLabel}"
                                           Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                                           Visibility="{Binding LearnedVisibility}" />
                                <Button Content="{Binding FoldLabel}" Tag="{Binding Id}" Click="OnLearn"
                                        Visibility="{Binding LearnVisibility}"
                                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ask people, not pages -->
            <TextBlock x:Name="AskTitle" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="AskSub" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="AskTopicBox" />
                    <TextBox x:Name="AskQuestionBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                    <Button x:Name="AskButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnAsk">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="AsksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <!-- the brief, not the typed question: this is
                                     the line that actually went out -->
                                <TextBlock Text="{Binding Brief}" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" FontSize="13" />
                                <TextBlock Text="{Binding Count}" FontSize="12"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                                <TextBlock Text="{Binding AnswersText}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource QrmeT2Brush}"
                                           Visibility="{Binding AnswersVisibility}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ReadLabel}" Tag="{Binding Id}" Click="OnReadAnswers"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                    <Button Content="{Binding CloseLabel}" Tag="{Binding Id}" Click="OnCloseAsk"
                                            Visibility="{Binding CloseVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeT2Brush}" />
                                    <Button Content="{Binding FoldLabel}" Tag="{Binding FoldTag}" Click="OnFoldAnswer"
                                            Visibility="{Binding FoldVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- and the other side: answering somebody else's question -->
            <TextBlock x:Name="BoardTitle" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="BoardSub" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
            <ItemsControl x:Name="BoardList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Brief}" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" FontSize="13" />
                                <TextBlock Text="{Binding AnswersText}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource QrmeT2Brush}"
                                           Visibility="{Binding AnswersVisibility}" />
                                <Button Content="{Binding ReadLabel}" Tag="{Binding Id}" Click="OnPickQuestion"
                                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="AnswerBox" Visibility="Collapsed"
                    Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="AnswerText" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="70" />
                    <TextBox x:Name="AliasBox" />
                    <TextBox x:Name="PointsBox" />
                    <Button x:Name="SendAnswerButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnSendAnswer">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <TextBlock x:Name="ReceiptText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
