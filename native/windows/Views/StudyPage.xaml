<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.StudyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="Sub"
                       Foreground="{StaticResource QrmeT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="TopicBox" />
                    <TextBox x:Name="QuestionBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                    <Button x:Name="StudyButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnStudy">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Search the Internet: a real search through the keyless
                 door, working on a deployment with no model configured —
                 which an excursion is not. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WebHead" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="WebQBox" />
                    <Button x:Name="WebGoButton" Click="OnWebSearch"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="WebNoneText" FontSize="11" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}" />
                    <ItemsControl x:Name="WebList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <HyperlinkButton Content="{Binding Title}"
                                                     NavigateUri="{Binding Uri}" FontSize="13" />
                                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HyperlinkButton x:Name="WebMoreLink" FontSize="11" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Watched pages: the vault re-reads each one on its schedule,
                 and the profile answers from the current capture. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LookoutHead" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="LookoutUrlBox" />
                    <TextBox x:Name="LookoutHoursBox" Text="24" />
                    <Button x:Name="LookoutPlantButton" Click="OnPlantLookout"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <ItemsControl x:Name="LookoutPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{StaticResource QrmeTxtBrush}" />
                                    <TextBlock Text="{Binding Trouble}" FontSize="11" TextWrapping="Wrap"
                                               Visibility="{Binding TroubleVisibility}"
                                               Foreground="{StaticResource QrmeRed}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding ReadLabel}" Tag="{Binding Id}"
                                                Click="OnReadLookout" Background="Transparent"
                                                Foreground="{StaticResource QrmeBrandABrush}" />
                                        <Button Content="{Binding DropLabel}" Tag="{Binding Id}"
                                                Click="OnDropLookout" Background="Transparent"
                                                Foreground="{StaticResource QrmeRed}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LookoutCapture" FontSize="12" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>

            <!-- the weekly letter: the profile's week, written to its owner -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LetterHead" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <Button x:Name="LetterWriteButton" Click="OnWriteLetter"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <ItemsControl x:Name="LetterPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding WeekStart}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource QrmeTxtBrush}" />
                                    <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <ItemsControl x:Name="ExcursionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="{Binding Topic}" FontWeight="Bold"
                                               Foreground="{StaticResource QrmeTxtBrush}" />
                                    <TextBlock Text="{Binding Badge}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding Redacted}" Foreground="{StaticResource QrmeT2Brush}"
                                           FontSize="12" Visibility="{Binding RedactedVisibility}" />
                                <TextBlock Text="{Binding Findings}" Foreground="{StaticResource QrmeTxtBrush}"
                                           FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FoldedLabel}"
                                           Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                                           Visibility="{Binding LearnedVisibility}" />
                                <Button Content="{Binding FoldLabel}" Tag="{Binding Id}" Click="OnLearn"
                                        Visibility="{Binding LearnVisibility}"
                                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ask people, not pages -->
            <TextBlock x:Name="AskTitle" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="AskSub" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="AskTopicBox" />
                    <TextBox x:Name="AskQuestionBox"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                    <Button x:Name="AskButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnAsk">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="AsksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <!-- the brief, not the typed question: this is
                                     the line that actually went out -->
                                <TextBlock Text="{Binding Brief}" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" FontSize="13" />
                                <TextBlock Text="{Binding Count}" FontSize="12"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                                <TextBlock Text="{Binding AnswersText}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource QrmeT2Brush}"
                                           Visibility="{Binding AnswersVisibility}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ReadLabel}" Tag="{Binding Id}" Click="OnReadAnswers"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                    <Button Content="{Binding CloseLabel}" Tag="{Binding Id}" Click="OnCloseAsk"
                                            Visibility="{Binding CloseVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeT2Brush}" />
                                    <Button Content="{Binding FoldLabel}" Tag="{Binding FoldTag}" Click="OnFoldAnswer"
                                            Visibility="{Binding FoldVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- where it keeps going back to -->
            <TextBlock x:Name="BeenTitle" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="BeenSub" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
            <ItemsControl x:Name="BeenList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Host}" FontWeight="Bold"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                                <TextBlock Text="{Binding Times}" FontSize="12"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                                <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding NoteVisibility}"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                                <Button Content="{Binding ActionLabel}" Tag="{Binding Host}"
                                        Click="OnToggleHost"
                                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- and the other side: answering somebody else's question -->
            <TextBlock x:Name="BoardTitle" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="BoardSub" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
            <ItemsControl x:Name="BoardList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Brief}" TextWrapping="Wrap"
                                           Foreground="{StaticResource QrmeTxtBrush}" FontSize="13" />
                                <TextBlock Text="{Binding AnswersText}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource QrmeT2Brush}"
                                           Visibility="{Binding AnswersVisibility}" />
                                <Button Content="{Binding ReadLabel}" Tag="{Binding Id}" Click="OnPickQuestion"
                                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="AnswerBox" Visibility="Collapsed"
                    Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="AnswerText" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="70" />
                    <TextBox x:Name="AliasBox" />
                    <TextBox x:Name="PointsBox" />
                    <Button x:Name="SendAnswerButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnSendAnswer">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <TextBlock x:Name="ReceiptText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
