<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.PostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold" Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="Sub"
                       Foreground="{StaticResource QrmeT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <ProgressRing x:Name="Loading" IsActive="True" Foreground="{StaticResource QrmeBrandABrush}"
                          Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock x:Name="Empty"
                       Foreground="{StaticResource QrmeT2Brush}" FontSize="13" Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <ItemsControl x:Name="PostsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource QrmeT2Brush}"
                                           FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="{Binding Content}" Foreground="{StaticResource QrmeTxtBrush}"
                                           FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Mark}" Foreground="{StaticResource QrmeT3Brush}"
                                           FontSize="10" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The public stream: the same rows, ranked for nobody. One card
                 at a time, and what plays is the server's decision. -->
            <TextBlock x:Name="StreamTitle" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="StreamSub" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="StreamKind" Foreground="{StaticResource QrmeBrandABrush}"
                               FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="StreamReason" Foreground="{StaticResource QrmeT3Brush}" FontSize="10" />
                    <TextBlock x:Name="StreamTitleLine" Foreground="{StaticResource QrmeTxtBrush}"
                               FontSize="14" TextWrapping="Wrap" />
                    <!-- Said before the button, because both reach a person. -->
                    <TextBlock x:Name="StreamSays" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StreamBack" Click="OnStreamBack" />
                        <Button x:Name="StreamAct" Click="OnStreamAct" />
                        <Button x:Name="StreamNext" Click="OnStreamNext" />
                    </StackPanel>
                    <TextBox x:Name="StreamItemId" />
                    <Button x:Name="StreamOpen" Click="OnStreamOpen" />
                    <TextBlock x:Name="StreamLine" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
