<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.WithoutAnAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <Grid>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource QrmeTxtBrush}" />
                <Button x:Name="BackButton" HorizontalAlignment="Right" Click="OnBack"
                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
            </Grid>
            <TextBlock x:Name="LeadText"
                       Foreground="{StaticResource QrmeT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <!-- Objecting -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ObjectHeading" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ObjectRestricts"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="ProfileBox" />
                    <TextBox x:Name="RefBox" />
                    <TextBox x:Name="ReasonBox"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                    <TextBlock x:Name="RefNote"
                               Foreground="{StaticResource QrmeT3Brush}" FontSize="11" TextWrapping="Wrap" />
                    <Button x:Name="ObjectButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnObject">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="OpenedCard" Background="{StaticResource QrmeCardBrush}"
                    BorderBrush="{StaticResource QrmeLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="OpenedTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="OpenedNote" Foreground="{StaticResource QrmeT2Brush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="WriteItDown"
                               Foreground="{StaticResource QrmeT3Brush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- The record of your own case -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TimelineTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <!-- No placeholder: the sibling box above carries "prf_…"
                         and is one of the 279 English literals recorded
                         against this shell. Adding a second untranslatable
                         hint to the one screen built for somebody who may not
                         read English is the wrong direction, and the id is
                         already shown to this reader on the card above. -->
                    <TextBox x:Name="TimelineIdBox" />
                    <Button x:Name="TimelineButton" HorizontalAlignment="Stretch" Height="42"
                            Foreground="White" Click="OnTimeline">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <StackPanel x:Name="TimelineList" Spacing="4" Visibility="Collapsed" />
                    <TextBlock x:Name="TimelineNote" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- The mark -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="MarkHeading" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="MarkExplain"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="ContentBox" AcceptsReturn="True" Height="110"
                             TextWrapping="Wrap" />
                    <Button x:Name="RecoverButton"
                            HorizontalAlignment="Stretch" Height="42" Foreground="White"
                            Click="OnRecover">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="FoundCard" Background="{StaticResource QrmeCardBrush}"
                    BorderBrush="{StaticResource QrmeLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="FoundTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="FoundBody" Foreground="{StaticResource QrmeT2Brush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="FoundDetail" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- The count -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CountHeading" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBox x:Name="CountIdBox" />
                    <Button x:Name="CountButton" HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnCount">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="CountCard" Background="{StaticResource QrmeCardBrush}"
                    BorderBrush="{StaticResource QrmeLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="CountNumbers" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="CountSays" Foreground="{StaticResource QrmeT2Brush}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="CountNote" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock x:Name="NoTokenText"
                       Foreground="{StaticResource QrmeT3Brush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
