<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <Grid MaxWidth="640" Padding="28" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="Subtitle" Foreground="{StaticResource QrmeT2Brush}"
                       FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource QrmeCardBrush}"
                                BorderBrush="{StaticResource QrmeLineBrush}" BorderThickness="1"
                                CornerRadius="13" Padding="12,9" Margin="0,0,0,8"
                                HorizontalAlignment="{Binding Align}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{StaticResource QrmeTxtBrush}" MaxWidth="420" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <!-- Rehearsal: practice the hard conversation — the transcript
                 lives only in the room, and closing the room wipes it. -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RehearsalBox" Grid.Column="0" />
                <Button x:Name="RehearsalButton" Grid.Column="1" Height="32"
                        Click="OnRehearsal" Background="Transparent" FontSize="12"
                        Foreground="{StaticResource QrmeBrandABrush}" />
            </Grid>
            <TextBlock x:Name="RehearsalLine" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource QrmeT2Brush}" Visibility="Collapsed" />
            <!-- Spec clauses 2/12 — advisor counsels, collaborator co-creates,
                 operator executes. "Read my prompt" is the honest default: the
                 profile infers from the wording and the reply says which. -->
            <!-- what this profile can do, before anything goes wrong -->
            <TextBlock x:Name="EscTitle" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="EscSub" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource QrmeT2Brush}" />
            <Button x:Name="EscShowButton" Click="OnEscShow"
                    Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
            <StackPanel x:Name="EscPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="EscWaiver" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource QrmeTxtBrush}" />
                <TextBlock x:Name="EscArmedLine" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource QrmeT2Brush}" />
                <!-- said now, not discovered at the worst moment -->
                <TextBlock x:Name="EscSealedLine" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource QrmeAmberBrush}" />
                <TextBox x:Name="EscSigBox" />
                <Button x:Name="EscArmButton" Click="OnEscArm"
                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                <Button x:Name="EscRaiseButton" Click="OnEscRaise"
                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                <Button x:Name="EscPressButton" Click="OnEscPress" Visibility="Collapsed"
                        Background="Transparent" Foreground="{StaticResource QrmeRedBrush}" />
                <TextBlock x:Name="EscSaid" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource QrmeTxtBrush}" />
            </StackPanel>

            <!-- bring somebody real into this -->
            <TextBlock x:Name="RealTitle" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource QrmeTxtBrush}" />
            <TextBlock x:Name="RealSub" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource QrmeT2Brush}" />
            <Button x:Name="RealOpenButton" Click="OnRealOpen"
                    Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
            <StackPanel x:Name="RealPanel" Spacing="8" Visibility="Collapsed">
                <TextBox x:Name="RealAreaBox" />
                <Button x:Name="RealFindButton" Click="OnRealFind"
                        Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                <ItemsControl x:Name="RealPeopleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                           Foreground="{StaticResource QrmeTxtBrush}" />
                                <TextBlock Text="{Binding Whose}" FontSize="11"
                                           Foreground="{StaticResource QrmeT2Brush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{Binding KeepLabel}" Tag="{Binding ProviderId}"
                                            Click="OnRealKeep" Visibility="{Binding KeepVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                    <Button Content="{Binding PreferLabel}" Tag="{Binding ProviderId}"
                                            Click="OnRealPrefer" Visibility="{Binding PreferVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                    <Button Content="{Binding DropLabel}" Tag="{Binding ProviderId}"
                                            Click="OnRealDrop" Visibility="{Binding MineVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeT2Brush}" />
                                    <Button Content="{Binding PreviewLabel}" Tag="{Binding ProviderId}"
                                            Click="OnRealPreview" Visibility="{Binding MineVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="RealMatterBox" />
                <PasswordBox x:Name="RealGrantBox" />
                <TextBlock x:Name="RealBriefText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource QrmeTxtBrush}" />
            </StackPanel>

            <ComboBox x:Name="RoleBox"
                      HorizontalAlignment="Stretch" SelectedIndex="0" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DraftBox" Grid.Column="0" />
                <Button x:Name="SendButton" Grid.Column="1" Height="36"
                        Foreground="White" Click="OnSend">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource QrmeBrandA}" Offset="0" />
                            <GradientStop Color="#FF3AA0FF" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
