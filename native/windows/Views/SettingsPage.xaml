<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="{StaticResource QrmeTxtBrush}" />

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Model" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock Text="Which LLM powers this profile. Unconfigured providers fall back to the offline stub."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnProviderPicked" />
                    <TextBlock x:Name="EffectiveText" Foreground="{StaticResource QrmeT2Brush}" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Language" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock Text="The profile speaks this language everywhere it appears — chat, posts, rooms, robot speech."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnLanguagePicked" />
                    <ToggleSwitch x:Name="PreTranslateToggle" Header="Speak it natively (pre-translate)"
                                  OnContent="The persona speaks the language everywhere"
                                  OffContent="Original voice kept — translate below"
                                  IsOn="True" Toggled="OnModeToggled" />
                    <TextBox x:Name="TranslateBox" Header="Translate anything"
                             PlaceholderText="Paste or type text…" />
                    <Button Content="Translate" Click="OnTranslate"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="TranslateOut" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="TranslateEngine" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Watermark" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock Text="Every piece of work your profile composes or generates carries this mark — on all textual and visual renders, at all times. Design it your way; the AI designation always stays."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="WatermarkLine" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="WatermarkMarkBox" Header="Mark" PlaceholderText="✦" Width="90" />
                        <TextBox x:Name="WatermarkLabelBox" Header="Label" PlaceholderText="AI · your profile" Width="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Save design" Click="OnSaveWatermark"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                        <Button x:Name="WatermarkResetButton" Content="Reset to default"
                                Click="OnResetWatermark" Visibility="Collapsed" />
                        <TextBlock x:Name="WatermarkSaved" Text="✓ saved" FontSize="12"
                                   Foreground="{StaticResource QrmeGreenBrush}" Visibility="Collapsed"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Objections" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="NoObjections" Text="No objections — nobody has contested this profile."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="13" />
                    <ItemsControl x:Name="ObjectionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,4">
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource QrmeTxtBrush}"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <Button Content="Re-attest my rights basis" Tag="{Binding Id}"
                                            Click="OnAttest" Visibility="{Binding AttestVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Steering" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock Text="Shape how the profile comes across — tone, pace, manner, look, age. Steering, not piloting: it acts on its own within this shape."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel x:Name="SteeringDials" Spacing="6" />
                    <TextBox x:Name="AppearanceBox" Header="Appearance"
                             PlaceholderText="How they look and present…" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox x:Name="BaseAgeBox" Header="Base age" Width="90" />
                        <ToggleSwitch x:Name="AgingToggle" Header="Ages over time"
                                      OnContent="On" OffContent="Off" />
                    </StackPanel>
                    <TextBlock x:Name="EffectiveAgeText" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="11" Visibility="Collapsed" />
                    <Button Content="Apply steering" Click="OnApplySteering"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="SteeringStatus" Foreground="{StaticResource QrmeGreenBrush}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Your relationship" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock Text="How the profile relates to you in chat — its framing, your nickname, the tone it takes."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="RelTypeBox" Header="Relationship" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="RelNicknameBox" PlaceholderText="Nickname it calls you (optional)" />
                    <TextBox x:Name="RelToneBox" PlaceholderText="Tone (e.g. gentle, playful) — optional" />
                    <Button Content="Save relationship" Click="OnSaveRelationship"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="RelStatus" Foreground="{StaticResource QrmeGreenBrush}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Help us improve" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock Text="Tell us how to make this better — an idea, a rough edge, a bug, or what you love. It goes straight to the team."
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="FeedbackCategory" Header="Category" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="FeedbackMessage" PlaceholderText="What's on your mind?"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                    <ComboBox x:Name="FeedbackRating" Header="Rating (optional)" HorizontalAlignment="Stretch" />
                    <Button x:Name="FeedbackSend" Content="Send feedback" Click="OnSendFeedback"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="FeedbackThanks" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="FeedbackTally" Foreground="{StaticResource QrmeT3Brush}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="FeedbackMineHeader" Text="Yours" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource QrmeTxtBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="FeedbackMine">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource QrmeT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- The other direction of the watermark: whose work is this, from
                 the text alone. /watermarks/verify needs an id up front and
                 fails on one edited character; this needs neither. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Who wrote this?" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}"
                               Text="Paste any passage. If a profile here produced it, this names it — even if the wording has since been changed." />
                    <TextBox x:Name="RecoverBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="90" PlaceholderText="Paste a passage…" />
                    <Button x:Name="RecoverButton" Content="Check this text" Click="OnRecover"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="RecoverVerdict" FontSize="14" FontWeight="Bold"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="RecoverCounts" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="RecoverDetail" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
