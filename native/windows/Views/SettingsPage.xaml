<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QrmeStudio.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource QrmeScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource QrmeTxtBrush}" />

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ModelHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ModelSub"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnProviderPicked" />
                    <TextBlock x:Name="EffectiveText" Foreground="{StaticResource QrmeT2Brush}" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- 0.58.0. The console has offered this since 0.4.3 and the
                 shells never did: a key set there was used there, and the
                 deployment's key used here, on the same profile. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="KeyHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="KeyLead" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <PasswordBox x:Name="KeyBox" />
                    <Button x:Name="SaveKeyButton" Click="OnSaveKey"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="InviteHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="InviteLead" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <PasswordBox x:Name="InviteBox" />
                    <Button x:Name="SaveInviteButton" Click="OnSaveInvite"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="LangHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="LangSub"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnLanguagePicked" />
                    <ToggleSwitch x:Name="PreTranslateToggle"
                                  IsOn="True" Toggled="OnModeToggled" />
                    <TextBlock x:Name="PreTranslateSub" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <TextBox x:Name="TranslateBox" />
                    <Button x:Name="TranslateButton" Click="OnTranslate"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="TranslateOut" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="TranslateEngine" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="WmHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="WmSub"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="WatermarkLine" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="WatermarkMarkBox" PlaceholderText="✦" Width="90" />
                        <TextBox x:Name="WatermarkLabelBox" Width="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="WatermarkSaveButton" Click="OnSaveWatermark"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                        <Button x:Name="WatermarkResetButton"
                                Click="OnResetWatermark" Visibility="Collapsed" />
                        <TextBlock x:Name="WatermarkSaved" FontSize="12"
                                   Foreground="{StaticResource QrmeGreenBrush}" Visibility="Collapsed"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ObjHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="NoObjections"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="13" />
                    <TextBlock x:Name="ObjStatus" FontSize="12" Visibility="Collapsed"
                               Foreground="{StaticResource QrmeGreenBrush}" />
                    <ItemsControl x:Name="ObjectionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,4">
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource QrmeT2Brush}" />
                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource QrmeTxtBrush}"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <Button Content="{Binding AttestLabel}" Tag="{Binding Id}"
                                            Click="OnAttest" Visibility="{Binding AttestVisibility}"
                                            Background="Transparent" Foreground="{StaticResource QrmeBrandABrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="StHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="StSub"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel x:Name="SteeringDials" Spacing="6" />
                    <TextBox x:Name="AppearanceBox" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox x:Name="BaseAgeBox" Width="90" />
                        <ToggleSwitch x:Name="AgingToggle" />
                    </StackPanel>
                    <TextBlock x:Name="EffectiveAgeText" Foreground="{StaticResource QrmeT3Brush}"
                               FontSize="11" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplySteeringButton" Click="OnApplySteering"
                                Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                        <!-- The personality nobody can move: while the lock
                             stands, no steering write lands. -->
                        <Button x:Name="SteeringLockButton" Click="OnSteeringLock"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource QrmeTxtBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="SteeringLockedText" Foreground="{StaticResource QrmeAmberBrush}"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="SteeringStatus" Foreground="{StaticResource QrmeGreenBrush}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="RelHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="RelSub"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="RelTypeBox" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="RelNicknameBox" />
                    <TextBox x:Name="RelToneBox" />
                    <Button x:Name="SaveRelButton" Click="OnSaveRelationship"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="RelStatus" Foreground="{StaticResource QrmeGreenBrush}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FbHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="FbSub"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="FeedbackCategory" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="FeedbackMessage"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                    <ComboBox x:Name="FeedbackRating" HorizontalAlignment="Stretch" />
                    <Button x:Name="FeedbackSend" Click="OnSendFeedback"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="FeedbackThanks" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="FeedbackTally" Foreground="{StaticResource QrmeT3Brush}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="FeedbackMineHeader" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource QrmeTxtBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="FeedbackMine">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource QrmeT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Ability is not a gate: the accessibility report door. Three
                 questions, none a diagnosis, sent with no token. The reviewer
                 row reads them back with the deployment's own token. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AccHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="AccLead"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <!-- The per-need statement the console makes, not just its form. -->
                    <TextBlock x:Name="AccNeedsTitle" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource QrmeTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccNeedsList"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccNeedsMore" FontStyle="Italic"
                               Foreground="{StaticResource QrmeT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="AccDoing" TextWrapping="Wrap" AcceptsReturn="True" Height="56" />
                    <TextBox x:Name="AccWall" TextWrapping="Wrap" AcceptsReturn="True" Height="72" />
                    <TextBox x:Name="AccHelp" TextWrapping="Wrap" AcceptsReturn="True" Height="56" />
                    <Button x:Name="AccSend" Click="OnSendAccessReport"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="AccThanks" Foreground="{StaticResource QrmeGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <PasswordBox x:Name="AccReviewerBox" />
                    <Button x:Name="AccLoad" Click="OnLoadAccessReports"
                            FontSize="12" />
                    <TextBlock x:Name="AccEmpty" Foreground="{StaticResource QrmeT3Brush}" FontSize="11"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="AccReportsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource QrmeT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QrmeRedBrush}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- The other direction of the watermark: whose work is this, from
                 the text alone. /watermarks/verify needs an id up front and
                 fails on one edited character; this needs neither. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WhoHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}"
                               x:Name="WhoSub" />
                    <TextBox x:Name="RecoverBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="90" />
                    <Button x:Name="RecoverButton" Click="OnRecover"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="RecoverVerdict" FontSize="14" FontWeight="Bold"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="RecoverCounts" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="RecoverDetail" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                </StackPanel>
            </Border>

            <!-- Your side of it: the mirror of the Attention card, scoped
                 to the person asking. Deliberately a card somebody opens
                 rather than a banner that appears — a panel that showed
                 itself when the ratio crossed a line would be the
                 notification the backend refuses to send, moved into the
                 shell. Take and Not now are the same weight; a highlighted
                 default is a thumb on the scale of a consent. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SideHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="SideSub" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <Button x:Name="SideReadButton" Click="OnReadMyCounts"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="SideCounts" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="SideNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                    <TextBlock x:Name="SideWhy" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <StackPanel x:Name="SideChoice" Orientation="Horizontal"
                                Spacing="8" Visibility="Collapsed">
                        <Button x:Name="SideTakeButton" Click="OnTakeTheDoor" />
                        <Button x:Name="SideNotNowButton" Click="OnCloseTheDoor" />
                    </StackPanel>
                    <Button x:Name="SideShowButton" Click="OnShowWhatWent"
                            Visibility="Collapsed" />
                    <TextBlock x:Name="SideReferral" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>

            <!-- Raising an objection: the half of governance that belongs to
                 the person who is *not* the profile's owner. This shell
                 carried the owner's half (list objections against your own
                 profile, attest to them) and nothing for the person on the
                 other side. `open_objection` takes no credential and says why
                 in its own docstring: the objecting party need not own an
                 account — so they have no console either. Placed beside "Who
                 wrote this?" because it is the same person one step on. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ObjectHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}"
                               x:Name="ObjectSub" />
                    <TextBox x:Name="ObjectProfileBox" />
                    <TextBox x:Name="ObjectContactBox" />
                    <TextBox x:Name="ObjectReasonBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="70" />
                    <Button x:Name="ObjectButton" Click="OnRaiseObjection"
                            Background="{StaticResource QrmeBrandABrush}" Foreground="White" />
                    <TextBlock x:Name="ObjectVerdict" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ObjectNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT3Brush}" />
                </StackPanel>
            </Border>
            <!-- The notice that has to be answered before anything leaves this
                 machine, and the switch that turns it off afterwards. The
                 preview below is built by Problems.Report — the same function
                 the sender posts — so what is shown is the payload rather than
                 a description of it. -->
            <Border Background="{StaticResource QrmeCardBrush}" BorderBrush="{StaticResource QrmeLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PrHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource QrmeTxtBrush}" />
                    <TextBlock x:Name="ProblemsExplain" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <StackPanel x:Name="ProblemsAsk" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ProblemsYes" Click="OnProblemsYes" />
                        <Button x:Name="ProblemsNo" Click="OnProblemsNo" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ProblemsSwitch"
                                  Toggled="OnProblemsToggled" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="ProblemsPreviewButton"
                                     Click="OnProblemsPreview" />
                    <TextBlock x:Name="ProblemsPreview" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Visibility="Collapsed"
                               Foreground="{StaticResource QrmeT2Brush}" />
                    <TextBlock x:Name="ProblemsServerTitle" FontWeight="SemiBold"
                               FontSize="13" Foreground="{StaticResource QrmeTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PasswordBox x:Name="ProblemsKeyBox" Width="220" />
                        <Button x:Name="ProblemsFetchButton" Click="OnProblemsFetch" />
                    </StackPanel>
                    <TextBlock x:Name="ProblemsServerRows" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Visibility="Collapsed"
                               Foreground="{StaticResource QrmeT2Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
