# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local databases & secrets — never commit runtime data
*.db
# SQLite's write-ahead sidecars. `*.db` alone does not cover them, so running
# the backend once leaves two untracked files sitting in `git status` for
# everybody — and untracked noise is how a real file gets missed in the scroll.
*.db-shm
*.db-wal
*.sqlite3
.env
.env.*

# Editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# tools/mark_verified.py --preview writes here; a preview is not an artifact.
verified-preview.png

# PyInstaller writes the generated build spec into the working directory when
# the backend is frozen locally; the release workflow regenerates it from
# flags, so it is a build artifact rather than source.
*.spec
